# Telegram
REF_BOT_KEY=your_telegram_bot_token_here
# Fallback webhook URL. Not needed for local F5 with a public VS Dev Tunnel (VS_TUNNEL_URL).
REF_BOT_WEBHOOK_URL=https://your-domain.com
# Bot username without @
BOT_USERNAME=your_bot_username
ADMIN_TELEGRAM_ID=123456789

# Referral link key length
KEY_LENGTH=8

# REST (X-Partners-Key). Empty = open locally.
PARTNERS_API_KEY=your_secret_api_key_here

# Stepik. Public catalog works without OAuth; teacher id 0 → empty list.
STEPIK_CLIENT_ID=your_stepik_client_id
STEPIK_CLIENT_SECRET=your_stepik_client_secret
STEPIK_TEACHER_ID=0
